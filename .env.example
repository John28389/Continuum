# Copy to .env.local and fill in. .env.local is git-ignored and must stay local.
# Never commit real values. Never paste these into a chat.

# --- Public -----------------------------------------------------------------
# Compiled into the browser bundle. That is not a leak: access is protected by
# row level security, not by the secrecy of these values.
#
# Supabase is migrating from the legacy JWT-shaped anon key to sb_publishable_.
# Either works. Which one your dashboard shows depends on when the project was
# created; NEXT_PUBLIC_SUPABASE_ANON_KEY is still read as a fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Local tooling only -----------------------------------------------------
# Used by the Supabase CLI on this machine. Never added to Vercel.
SUPABASE_ACCESS_TOKEN=

# Overrides the local Postgres connection used by the SQL invariant suite.
# The default matches the standard local Supabase stack.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Never ------------------------------------------------------------------
# The service role / secret key bypasses row level security entirely and is
# deliberately not part of this application's architecture. If something seems
# to need it, the design is wrong.
